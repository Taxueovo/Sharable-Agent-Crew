# Copy to .env and fill in real values. Do not commit .env to Git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
PUBLIC_BASE_URL=

# Use two different randomly generated values of at least 32 bytes. PUBLISH_TOKEN
# is used by the local publishing relay and must also be installed as a Worker secret.
PUBLISH_TOKEN=
RUN_SESSION_SECRET=
# During rotation, move the old value to PREVIOUS, install a new current secret,
# and change the non-secret ID. Remove PREVIOUS after all one-hour sessions expire.
RUN_SESSION_SECRET_PREVIOUS=
RUN_SESSION_SECRET_ID=2026-08

# Public-run cost controls.
MAX_TEAM_RUNS_PER_MONTH=1000
MAX_TEAM_OUTPUT_TOKENS_PER_DAY=200000

# Set to 1 when publishing must come from ChatGPT auth or Cloudflare Access.
REQUIRE_AUTHENTICATED_PUBLISHER=0

# Admin token (optional): enables admin mode in "Share & Permissions" to manage
# versions shared by others (list / deactivate / permanently delete any version
# in the database).
# Important: do not write it into a .env that will be distributed. Set it separately
# after deploying to Cloudflare with:
#   npx wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=
